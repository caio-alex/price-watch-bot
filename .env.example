# Token do bot do Telegram (obtido via @BotFather)
TELEGRAM_BOT_TOKEN=coloque_seu_token_aqui

# Seu chat_id do Telegram (obtido enviando uma mensagem ao bot e consultando
# https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=coloque_seu_chat_id_aqui

# Intervalo entre verificações, em minutos
CHECK_INTERVAL_MINUTES=30
